{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/*.ts", "*.ts"]
    },
    "apps/server": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["src/**/*.test.ts", "auth-schema.config.ts"],
      "project": ["src/**/*.ts", "*.ts"]
    },
    "packages/connectors/codex": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.ts"]
    },
    "packages/connectors/vercel-ai-gateway": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/connectors/grok": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
