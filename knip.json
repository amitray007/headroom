{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": ["*.ts"]
    },
    "apps/server": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["src/**/*.test.ts", "auth-schema.config.ts"],
      "project": ["src/**/*.ts", "*.ts"]
    }
  }
}
