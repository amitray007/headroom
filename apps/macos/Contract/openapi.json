{
  "components": {
    "schemas": {
      "AppFeed": {
        "additionalProperties": false,
        "properties": {
          "accounts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "banked": {
                  "additionalProperties": false,
                  "properties": {
                    "count": {
                      "minimum": 0,
                      "type": ["number", "null"]
                    },
                    "expiries": {
                      "items": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "type": "array"
                    },
                    "interface": {
                      "enum": ["official", "private"],
                      "type": "string"
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": ["count", "unit", "expiries", "interface"],
                  "type": ["object", "null"]
                },
                "charges": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "availability": {
                        "enum": [
                          "available",
                          "unsupported",
                          "not_authorized",
                          "temporarily_unavailable",
                          "unknown"
                        ],
                        "type": "string"
                      },
                      "cap": {
                        "additionalProperties": false,
                        "properties": {
                          "unit": {
                            "type": "string"
                          },
                          "value": {
                            "type": "number"
                          }
                        },
                        "required": ["value", "unit"],
                        "type": ["object", "null"]
                      },
                      "interface": {
                        "enum": ["official", "private"],
                        "type": "string"
                      },
                      "key": {
                        "type": "string"
                      },
                      "kind": {
                        "enum": ["spend", "balance", "count"],
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "unit": {
                        "type": "string"
                      },
                      "unlimited": {
                        "type": "boolean"
                      },
                      "value": {
                        "type": ["number", "null"]
                      },
                      "window": {
                        "type": ["string", "null"]
                      }
                    },
                    "required": [
                      "key",
                      "label",
                      "kind",
                      "value",
                      "unit",
                      "cap",
                      "window",
                      "unlimited",
                      "availability",
                      "interface"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "id": {
                  "type": "string"
                },
                "identity": {
                  "type": ["string", "null"]
                },
                "interface": {
                  "enum": ["official", "private"],
                  "type": "string"
                },
                "lastSuccessAt": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": ["integer", "null"]
                },
                "limits": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "interface": {
                        "enum": ["official", "private"],
                        "type": "string"
                      },
                      "key": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "notStarted": {
                        "type": "boolean"
                      },
                      "part": {
                        "type": "boolean"
                      },
                      "percentLeft": {
                        "maximum": 100,
                        "minimum": 0,
                        "type": ["number", "null"]
                      },
                      "resetWords": {
                        "enum": ["resets", "cycle_end", "not_started"],
                        "type": "string"
                      },
                      "resetsAt": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": ["integer", "null"]
                      },
                      "runsOutAt": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": ["integer", "null"]
                      },
                      "unlimited": {
                        "type": "boolean"
                      },
                      "window": {
                        "type": ["string", "null"]
                      },
                      "windowKind": {
                        "enum": ["session", "weekly", "cycle", "other"],
                        "type": "string"
                      }
                    },
                    "required": [
                      "key",
                      "label",
                      "window",
                      "windowKind",
                      "percentLeft",
                      "unlimited",
                      "notStarted",
                      "resetsAt",
                      "resetWords",
                      "runsOutAt",
                      "part",
                      "interface"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "name": {
                  "type": "string"
                },
                "observedAt": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": ["integer", "null"]
                },
                "plan": {
                  "type": ["string", "null"]
                },
                "provider": {
                  "enum": [
                    "codex",
                    "claude",
                    "grok",
                    "antigravity",
                    "copilot",
                    "cursor",
                    "vercel_ai_gateway"
                  ],
                  "type": "string"
                },
                "reconnectReason": {
                  "enum": [
                    "refresh_rejected",
                    "token_rejected",
                    "identity_changed",
                    "revoked_by_owner",
                    null
                  ],
                  "type": ["string", "null"]
                },
                "state": {
                  "enum": ["ready", "partial", "reconnect_required", "paused"],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "provider",
                "name",
                "plan",
                "identity",
                "state",
                "reconnectReason",
                "interface",
                "lastSuccessAt",
                "observedAt",
                "limits",
                "charges",
                "banked"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "apiVersion": {
            "const": 1,
            "type": "number"
          },
          "dashboardUrl": {
            "format": "uri",
            "type": ["string", "null"]
          },
          "generatedAt": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "notices": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "connection": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "identity": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "name": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "plan": {
                      "type": ["string", "null"]
                    }
                  },
                  "required": ["id", "name", "plan"],
                  "type": "object"
                },
                "figures": {
                  "additionalProperties": false,
                  "properties": {
                    "amount": {
                      "additionalProperties": false,
                      "properties": {
                        "unit": {
                          "enum": [
                            "USD",
                            "codex_credits",
                            "grok_credits",
                            "gateway_credits",
                            "credits"
                          ],
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        }
                      },
                      "required": ["value", "unit"],
                      "type": "object"
                    },
                    "cap": {
                      "additionalProperties": false,
                      "properties": {
                        "unit": {
                          "enum": [
                            "USD",
                            "codex_credits",
                            "grok_credits",
                            "gateway_credits",
                            "credits"
                          ],
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        }
                      },
                      "required": ["value", "unit"],
                      "type": "object"
                    },
                    "expiresAt": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "percentLeft": {
                      "type": "number"
                    },
                    "percentUsed": {
                      "type": "number"
                    },
                    "resetsAt": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "runsOutAt": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "almost_out",
                    "running_low",
                    "pacing",
                    "reset_expiring",
                    "balance_low",
                    "spend_near_cap",
                    "spend_cap_reached",
                    "extra_usage_started",
                    "refresh_failed",
                    "disconnected",
                    "reset_granted",
                    "early_reset",
                    "auto_reset",
                    "top_up_detected",
                    "budget_near",
                    "budget_exceeded",
                    "credits_expiring"
                  ],
                  "type": "string"
                },
                "links": {
                  "additionalProperties": false,
                  "properties": {
                    "dashboard": {
                      "format": "uri",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "message": {
                  "minLength": 1,
                  "type": "string"
                },
                "observedAt": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "occurredAt": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "provider": {
                  "enum": [
                    "codex",
                    "claude",
                    "grok",
                    "antigravity",
                    "copilot",
                    "cursor",
                    "vercel_ai_gateway"
                  ],
                  "type": "string"
                },
                "schemaVersion": {
                  "const": 1,
                  "type": "number"
                },
                "subject": {
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": ["string", "null"]
                    },
                    "metricKey": {
                      "type": ["string", "null"]
                    },
                    "window": {
                      "type": ["string", "null"]
                    }
                  },
                  "required": ["metricKey", "label", "window"],
                  "type": "object"
                },
                "title": {
                  "minLength": 1,
                  "type": "string"
                },
                "tone": {
                  "enum": ["bad", "warn", "info"],
                  "type": "string"
                }
              },
              "required": [
                "schemaVersion",
                "id",
                "kind",
                "tone",
                "occurredAt",
                "observedAt",
                "provider",
                "connection",
                "subject",
                "figures",
                "title",
                "message",
                "links"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "providerOrder": {
            "items": {
              "enum": [
                "codex",
                "claude",
                "grok",
                "antigravity",
                "copilot",
                "cursor",
                "vercel_ai_gateway"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "refreshIntervalMs": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "serverVersion": {
            "type": "string"
          },
          "staleAfterMs": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "summary": {
            "additionalProperties": false,
            "properties": {
              "extraSpend": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "unit": {
                      "type": "string"
                    },
                    "value": {
                      "type": ["number", "null"]
                    }
                  },
                  "required": ["unit", "value"],
                  "type": "object"
                },
                "type": "array"
              },
              "monthlyPlanTotal": {
                "additionalProperties": false,
                "properties": {
                  "currency": {
                    "enum": ["USD", "EUR", "GBP", "INR", "CAD", "AUD", "JPY", "SGD", "CHF", "BRL"],
                    "type": "string"
                  },
                  "minor": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  }
                },
                "required": ["minor", "currency"],
                "type": ["object", "null"]
              },
              "nextLimitBack": {
                "additionalProperties": false,
                "properties": {
                  "accountId": {
                    "type": "string"
                  },
                  "at": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "metricKey": {
                    "type": "string"
                  }
                },
                "required": ["accountId", "metricKey", "at"],
                "type": ["object", "null"]
              }
            },
            "required": ["monthlyPlanTotal", "extraSpend", "nextLimitBack"],
            "type": "object"
          }
