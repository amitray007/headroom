        "required": [
          "apiVersion",
          "serverVersion",
          "generatedAt",
          "refreshIntervalMs",
          "staleAfterMs",
          "dashboardUrl",
          "providerOrder",
          "accounts",
          "summary",
          "notices"
        ],
        "type": "object"
      },
      "AppRefresh": {
        "additionalProperties": false,
        "properties": {
          "refreshIntervalMinutes": {
            "enum": [2, 5, 10, 15, 30],
            "type": "number"
          }
        },
        "required": ["refreshIntervalMinutes"],
        "type": "object"
      },
      "AppWhoami": {
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "const": 1,
            "type": "number"
          },
          "scopes": {
            "items": {
              "enum": ["read", "refresh"],
              "type": "string"
            },
            "type": "array"
          },
          "serverVersion": {
            "type": "string"
          },
          "tokenName": {
            "type": ["string", "null"]
          }
        },
        "required": ["apiVersion", "serverVersion", "tokenName"],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "appToken": {
        "bearerFormat": "Headroom app token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Headroom App API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/app/v1/feed": {
      "get": {
        "operationId": "getAppFeed",
        "parameters": [
          {
            "description": "Whole minutes east of UTC. Plain integer; defaults to 0.",
            "in": "query",
            "name": "tz",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 840,
              "minimum": -720,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "If-None-Match",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppFeed"
                }
              }
            },
            "description": "Current source data. Cache-Control: no-store.",
            "headers": {
              "ETag": {
                "description": "Strong SHA-256 body validator.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The feed is unchanged. No response body.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid query: invalid_tz."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing, expired, revoked or invalid token: invalid_token."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Only GET and HEAD are allowed: method_not_allowed.",
            "headers": {
              "Allow": {
                "schema": {
                  "const": "GET, HEAD",
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Too many authentication attempts: rate_limited.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "appToken": []
          }
        ]
      }
    },
    "/api/app/v1/settings/refresh": {
      "put": {
        "operationId": "putAppRefresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppRefresh"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppRefresh"
                }
              }
            },
            "description": "The saved interval. The server collects on the new interval from its next tick."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The body is not one of the allowed intervals: invalid_body."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing, expired, revoked or invalid token: invalid_token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The token was created without the refresh scope: missing_permission."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Only PUT is allowed: method_not_allowed.",
            "headers": {
              "Allow": {
                "schema": {
                  "const": "PUT",
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Too many authentication attempts: rate_limited.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "appToken": []
          }
        ]
      }
    },
    "/api/app/v1/whoami": {
      "get": {
        "operationId": "getAppWhoami",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppWhoami"
                }
              }
            },
            "description": "Current source data. Cache-Control: no-store."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid query: invalid_tz."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing, expired, revoked or invalid token: invalid_token."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Only GET and HEAD are allowed: method_not_allowed.",
            "headers": {
              "Allow": {
                "schema": {
                  "const": "GET, HEAD",
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Too many authentication attempts: rate_limited.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "appToken": []
          }
        ]
      }
    }
  }
}
