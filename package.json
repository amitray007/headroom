{
  "name": "headroom",
  "version": "0.1.3",
  "private": true,
  "description": "Self-hosted dashboard for AI account allowances, balances and usage",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/connectors/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --watch apps/server/src/index.ts",
    "build": "bun run web:build && bun run build:server",
    "build:server": "bun scripts/build-server.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "bun test",
    "knip": "knip",
    "docs:check": "python3 scripts/check_docs.py",
    "check": "bun run docs:check && bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run test",
    "audit:dependencies": "bun audit --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "cd packages/core && bunx auth@1.7.7 generate --config auth-schema.config.ts --output src/db/auth-schema.ts --yes",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "web:build:demo": "bun run --cwd apps/web build --mode demo"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "knip": "6.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
