{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "promise", "node", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "es2024": true
  },
  "rules": {
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "unicorn/prefer-node-protocol": "error",
    "no-console": "error",
    "no-debugger": "error",
    "eqeqeq": "error"
  },
  "overrides": [
    {
      "files": ["apps/server/src/index.ts", "drizzle.config.ts", "apps/web/vite.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["packages/core/auth-schema.config.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["scripts/*.ts"],
      "rules": {
        "no-console": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["site/**"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["apps/web/**"],
      "plugins": ["react", "jsx-a11y"],
      "env": {
        "browser": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off",
        "typescript/consistent-return": "off",
        "import/no-unassigned-import": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "node_modules/**", "**/fixtures/**"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  }
}
