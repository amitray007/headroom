{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "bun.lock",
    "mise.lock",
    "**/*.md",
    ".release-please-manifest.json"
  ]
}
