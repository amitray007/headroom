# Copy to deploy/.env (ignored by Git) or set these in Dokploy. Never commit real values.

# Required. A Tailscale auth key: reusable off, ephemeral off, pre-approved; tagged if your ACLs use tags.
TS_AUTHKEY=
# The node name on the tailnet. The app is served at https://<TS_HOSTNAME>.<tailnet>.ts.net.
TS_HOSTNAME=headroom
# Optional extra `tailscale up` flags, for example --advertise-tags=tag:server
TS_EXTRA_ARGS=

# Required. Must be exactly the HTTPS address above: passkeys, secure cookies and links use it.
HEADROOM_PUBLIC_URL=https://headroom.your-tailnet.ts.net

# Optional.
HEADROOM_ENABLED_PROVIDERS=codex,claude,grok,antigravity,copilot,cursor,vercel_ai_gateway
HEADROOM_LOG_LEVEL=info
HEADROOM_REFRESH_INTERVAL_SECONDS=900
HEADROOM_STALE_AFTER_SECONDS=43200
# Time zone for dates in Telegram and webhook messages, for example Asia/Kolkata.
TZ=UTC
